# 集成测试环境模板。复制为 .env.integration（已在 .gitignore 里）后按实际情况改。
#
#   cp .env.integration.example .env.integration
#   scripts/test-integration.sh
#
# 真的 .env.integration **不要提交**：里面有本机/CI 的地址与密码。

# 只允许 local / dev / ci。prod 会被脚本直接拒跑（集成测试会往库里写测试键）。
TEST_ENV=local

# 真实 Redis；脚本会先 TCP 连通性检查，连不通直接失败退出。
#   本地起：docker run -d --name dp-e2e-redis -p 6379:6379 redis:7-alpine
DP_E2E_REDIS_URL=redis://127.0.0.1:6379/0

# 真实 VictoriaMetrics。单机版两个地址填同一个 + 打开 DP_E2E_VM_SINGLE_NODE。
#   本地起：docker run -d --name dp-e2e-vm -p 8428:8428 victoriametrics/victoria-metrics
DP_E2E_VM_INSERT_URL=http://127.0.0.1:8428
DP_E2E_VM_SELECT_URL=http://127.0.0.1:8428
# 单机版：地址不带 /insert|/select 前缀。
DP_E2E_VM_SINGLE_NODE=1

# 可选：VM 删除鉴权（vmselect -deleteAuthKey）。不设时删除路径只验错误分支。
# DP_E2E_VM_DELETE_AUTH_KEY=
# 可选：允许整序列删除（VM 删除接口不支持 start/end）。
# DP_E2E_VM_DELETE_ENABLED=1
