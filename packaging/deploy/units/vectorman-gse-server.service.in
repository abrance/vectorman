[Unit]
Description=Vectorman GSE Server (geminio RPC + ledger HTTP + web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@INSTALL_ROOT@
Environment=GSE_SERVER_CONFIG=@INSTALL_ROOT@/conf/gse-server.toml
ExecStart=@INSTALL_ROOT@/bin/gse-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
